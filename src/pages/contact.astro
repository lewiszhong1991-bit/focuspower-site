---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import businessLicense from '~/assets/images/gallery/business-license.jpg';

const metadata = {
  title: '联系我们',
  description:
    '联系战神电器获取12V蓄电池充电器OEM/ODM报价。工厂位于广东中山，1-2个工作日内回复。',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="联系我们"
    title="1-2个工作日内获取报价"
    subtitle="发邮件或加微信，告诉我们你的目标充电器型号、数量和目的国。我们的外贸团队会回复规格、报价和样品方案。"
  />

  <Features2
    title="工厂联系方式"
    items={[
      {
        title: '销售与外贸',
        description:
          '报价、样品、OEM/ODM项目、柜级订单。我们1-2个工作日内回复。',
        icon: 'tabler:briefcase',
      },
      {
        title: '邮箱',
        description: '317073043@qq.com',
        icon: 'tabler:mail',
      },
      {
        title: '微信电话同号',
        description: '15914376302（微信 / 手机 / WhatsApp 同号）',
        icon: 'tabler:message-circle',
      },
      {
        title: '公司地址',
        description: '中山市小榄镇绩东二社区盛裕路1号4栋401卡之二',
        icon: 'tabler:map-pin',
      },
      {
        title: '工作时间',
        description: '周一至周六，9:00 - 18:00（北京时间 UTC+8）',
        icon: 'tabler:clock',
      },
      {
        title: '认证文件',
        description: '每笔出口订单均可提供CE、RoHS文件。',
        icon: 'tabler:certificate',
      },
    ]}
  />

  <section class="max-w-3xl mx-auto px-4 py-12 text-center">
    <h2 class="text-2xl font-bold mb-6 dark:text-white">营业执照 / Business License</h2>
    <a href={businessLicense.src} target="_blank" rel="noopener">
      <img
        src={businessLicense.src}
        alt="中山市战神电器有限公司营业执照"
        class="mx-auto rounded-lg shadow-lg max-h-96 w-auto border"
      />
    </a>
    <p class="mt-3 text-sm text-muted">点击图片可放大查看 / Click to enlarge</p>
  </section>
</Layout>
