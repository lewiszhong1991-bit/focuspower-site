---
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '关于我们',
  description:
    '中山市战神电器有限公司——位于广东中山的12V蓄电池充电器OEM/ODM源头工厂。专注研发、生产、出口铅酸和锂电池充电器。',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="关于我们 / About Us"
    image={{
      src: '~/assets/images/gallery/factory/9c01571d586e47f01d8c80c326bb2e1f.webp',
      alt: '战神电器生产工作台',
    }}
  >
    <Fragment slot="title">
      12V蓄电池充电器源头工厂，<span class="text-accent dark:text-white">专为全球出口打造</span><br />
      <span class="text-2xl md:text-3xl font-semibold opacity-80">12V Battery Charger Source Factory, Built for Global Export</span>
    </Fragment>

    <Fragment slot="subtitle">
      中山市战神电器有限公司位于广东中山——中国灯饰电源产业基地。我们是一家集研发、设计、生产、出口于一体的12V蓄电池充电设备专业工厂，专注鳄鱼夹充电器、铅酸充电器和12.6V锂电池充电器，广泛适配摩托车、汽车、太阳能储能和户外电源等场景。<br />
      <span class="opacity-70">Zhongshan FocusPower is a source factory in Zhongshan, Guangdong — China's lighting & power supply hub. We specialize in R&D, production and export of 12V battery chargers, alligator clip chargers and 12.6V lithium chargers for motorcycles, cars, solar storage and outdoor power systems.</span>
    </Fragment>
  </Hero>

  <Stats
    title="数字说话 / By the Numbers"
    stats={[
      { title: '㎡ 自有厂房', amount: '8,000' },
      { title: '日产能（台）', amount: '100,000' },
      { title: '出口国家', amount: '30+' },
      { title: '实用新型专利', amount: '12' },
    ]}
  />

  <Features3
    title="我们的核心优势 / Our Advantages"
    subtitle="我们是工厂，不是贸易公司。每一台出厂的充电器都基于自主研发电路，在自有生产线上制造。<br /><span class='opacity-70'>We are the factory, not a trading company. Every charger is built on our own circuit design, on our own production line.</span>"
    columns={2}
    isBeforeContent={true}
    items={[
      {
        title: '自主研发与专利 / In-house R&D & Patents',
        description:
          '在充电优化电路、防水防护结构、鳄鱼夹连接设计等领域拥有多项实用新型专利——彻底区别于市面公模产品。<br /><span class="opacity-70">Utility model patents on charging circuits, waterproof housing and clip structure — no generic OEM products.</span>',
        icon: 'tabler:microscope',
      },
      {
        title: 'OEM/ODM定制 / Custom OEM/ODM',
        description:
          '根据你的目标市场定制功能、外观、接头、插头标准和包装。我们把你的需求清单变成样品，再变成量产。<br /><span class="opacity-70">Customize functions, appearance, connectors, plug standards and packaging for your target market.</span>',
        icon: 'tabler:settings',
      },
      {
        title: '自动化生产与品控 / Automated Production & QC',
        description:
          '自动化SMT和组装线、精密检测仪器、专业老化测试车间。出货前100%老化测试，从原材料到包装箱全流程可追溯。<br /><span class="opacity-70">Automated SMT and assembly lines, precision testing equipment, 100% burn-in test before shipment. Full traceability from raw materials to carton.</span>',
        icon: 'tabler:building-factory',
      },
      {
        title: '出口认证齐全 / Export Certified',
        description:
          '产品符合国际出口标准，可提供CE、RoHS文件。适配多国电压和插头标准，服务品牌商、贸易商和工程客户。<br /><span class="opacity-70">CE & RoHS certified, adapted for global voltage and plug standards. Serving brands, traders and engineering clients worldwide.</span>',
        icon: 'tabler:ship',
      },
    ]}
  />

  <Steps2
    title="我们怎么跟你合作 / How We Work With You"
    subtitle="从第一次询盘到返单装柜，同一个团队全程对接你的订单。<br /><span class='opacity-70'>One team handles your order from first inquiry to repeat container shipment.</span>"
    items={[
      {
        title: '技术先行，不是销售导向 / Engineering-first, not sales-first',
        description:
          '我们的外贸工程师先读你的规格书再报价。如果某款充电器不适合你的电池类型，我们会直接告诉你，并推荐合适的型号。',
      },
      {
        title: '质量优先于数量 / Quality Over Quantity',
        description:
          '日产10万台的前提是每条线都执行同一套品控标准。我们宁愿延迟一批货，也不发有疑问的产品。',
      },
      {
        title: '长期供货伙伴 / Long-term Supply Partner',
        description:
          '我们为返单而设计：稳定的BOM、一致的模具、规范的规格书。一旦你确认样品，每次返单都是同样的产品。',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: '获取报价 / Get Quote',
        href: '/contact',
        icon: 'tabler:send',
      },
    ]}
  >
    <Fragment slot="title">
      在找一家靠谱的12V充电器工厂？<br class="hidden sm:block" />
    </Fragment>
    <Fragment slot="subtitle">
      把你的规格发给我们——2个工作日内回复样品方案和FOB/CIF报价。
    </Fragment>
  </CallToAction>
</Layout>
