---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: '联系我们',
  description:
    '联系战神电器获取12V蓄电池充电器OEM/ODM报价。工厂位于广东中山，1-2个工作日内回复。',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="联系我们"
    title="1-2个工作日内获取报价"
    subtitle="发邮件或加微信，告诉我们你的目标充电器型号、数量和目的国。我们的外贸团队会回复规格、报价和样品方案。"
  />

  <Features2
    title="工厂联系方式"
    items={[
      {
        title: '销售与外贸',
        description:
          '报价、样品、OEM/ODM项目、柜级订单。我们1-2个工作日内回复。',
        icon: 'tabler:briefcase',
      },
      {
        title: '邮箱',
        description: '317073043@qq.com',
        icon: 'tabler:mail',
      },
      {
        title: '微信电话同号',
        description: '15914376302（微信 / 手机 / WhatsApp 同号）',
        icon: 'tabler:message-circle',
      },
      {
        title: '公司地址',
        description: '中山市小榄镇绩东二社区盛裕路1号4栋401卡之二',
        icon: 'tabler:map-pin',
      },
      {
        title: '工作时间',
        description: '周一至周六，9:00 - 18:00（北京时间 UTC+8）',
        icon: 'tabler:clock',
      },
      {
        title: '认证文件',
        description: '每笔出口订单均可提供CE、RoHS文件。',
        icon: 'tabler:certificate',
      },
    ]}
  />
</Layout>
