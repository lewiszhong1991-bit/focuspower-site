---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import SocialProof from '~/components/widgets/SocialProof.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import Gallery from '~/components/widgets/Gallery.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';
import pClip from '~/assets/images/gallery/products/156e7bb9659bdc9de2de803df02f3142.webp';
import pAlligator from '~/assets/images/gallery/products/1a48ad2016cd28af8bfb5d26ce9751f0.webp';
import pBattery from '~/assets/images/gallery/products/23738a458de3d1a0ad192cd9558c2451.webp';
import pLeadAcid from '~/assets/images/gallery/products/07c9bea85ba2e547d80922b67f8207ce.webp';
import pLithium from '~/assets/images/gallery/products/177045136c03cc258f240a0ebe438ed4.webp';

const allProductImports = import.meta.glob('~/assets/images/gallery/products/*.webp', { eager: true }) as Record<string, { default: { src: string } }>;
const galleryImages = Object.entries(allProductImports).map(([path, mod]) => ({
  src: mod.default.src,
  alt: 'focusPower 产品图',
}));

const metadata = {
  title: '12V蓄电池充电器源头工厂 | OEM/ODM定制 - 中山战神电器',
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: '中山市战神电器有限公司',
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    description:
      '位于广东中山的12V蓄电池充电器专业源头工厂，专注研发生产鳄鱼夹充电器、铅酸电池充电器、锂电池充电器，提供OEM/ODM定制服务。',
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- Hero *********************************************** -->
  <Hero
    tagline="OEM/ODM 蓄电池充电器源头工厂 / Battery Charger Factory"
    actions={[
      {
        variant: 'primary',
        text: '获取报价 / Get Quote',
        href: '/contact',
        icon: 'tabler:send',
      },
      { text: '查看产品 / View Products', href: '#products', icon: 'tabler:bolt' },
    ]}
    image={{
      src: '~/assets/images/gallery/products/1a48ad2016cd28af8bfb5d26ce9751f0.webp',
      alt: 'focusPower ZS-49 30W PD 鳄鱼夹充电器',
    }}
  >
    <Fragment slot="title">
      12V蓄电池充电器，
      <span class="text-accent dark:text-white">为全球品牌量身打造</span><br />
      <span class="text-2xl md:text-3xl lg:text-4xl font-semibold opacity-80">12V Battery Chargers, engineered for global brands</span>
    </Fragment>

    <Fragment slot="subtitle">
      中山战神电器是一家专注12V蓄电池充电器研发、生产与出口的源头工厂。我们位于广东中山，拥有8000㎡自有厂房，日产10万台，产品远销全球30多个国家，提供完整的OEM/ODM定制服务，通过CE、RoHS国际认证。<br />
      <span class="opacity-70">Zhongshan FocusPower is a source factory specializing in R&D, production and export of 12V battery chargers. 8,000 m² plant, 100,000 units/day, CE & RoHS certified, shipping to 30+ countries.</span>
    </Fragment>
  </Hero>

  <!-- Stats ********************************************** -->
  <Stats
    id="stats"
    countUp
    classes={{ container: '!py-10 md:!py-14' }}
    stats={[
      { title: '㎡ 自有厂房', amount: '8,000' },
      { title: '日产能（台）', amount: '100,000' },
      { title: '出口国家', amount: '30+' },
      { title: '实用新型专利', amount: '12' },
    ]}
  />

  <!-- Products ******************************************** -->
  <Features
    id="products"
    tagline="核心产品 / Core Products"
    title="自主研发电路，告别公模同质化"
    subtitle="每款产品都基于我们自主研发的充电优化电路、防水防护结构和鳄鱼夹稳定连接结构——彻底区别于市面普通公模产品。"
    items={[
      {
        title: '12V夹子充电器 / 12V Clip Charger',
        description:
          '适用于摩托车、汽车、应急启动等场景。弹簧夹触点稳定，绝缘外壳，多种电流规格可选，适配全球多国电压标准。<br /><span class="opacity-70">For motorcycles, cars and emergency use. Stable spring-loaded contacts, insulated housing, multiple current ratings for global voltage standards.</span>',
        icon: 'tabler:plug-connected',
      },
      {
        title: '12V鳄鱼夹充电器 / 12V Alligator Clip Charger',
        description:
          '自主研发充电优化电路，防水防护结构，鳄鱼夹稳定连接。支持QC3.0/PD快充，AUTO-ID自动识别，专为户外和储能场景设计。<br /><span class="opacity-70">In-house optimized charging circuit, waterproof housing, patented clip structure. QC3.0/PD fast charge, AUTO-ID, built for outdoor and solar storage.</span>',
        icon: 'tabler:battery-charging',
      },
      {
        title: '12V蓄电池充电器 / 12V Battery Charger',
        description:
          '适用于汽车蓄电池、摩托车电瓶、备用电源等场景。多级智能充电，过充、反接、短路全保护，适配12V各类铅酸电池。<br /><span class="opacity-70">For car batteries, motorcycle batteries and backup power. Multi-stage smart charging, over-charge, reverse-polarity and short-circuit protection for all 12V lead-acid batteries.</span>',
        icon: 'tabler:battery-3',
      },
      {
        title: '12V铅酸电瓶充电器 / 12V Lead-Acid Battery Charger',
        description:
          '专为富液式、AGM、胶体铅酸电池设计。三段式充电曲线，充满自停，浮充维护，适用于汽车、船舶、离网储能系统。<br /><span class="opacity-70">Designed for flooded, AGM and gel lead-acid batteries. 3-stage charging, auto shut-off, float maintenance. For cars, boats and off-grid systems.</span>',
        icon: 'tabler:battery-charging',
      },
      {
        title: '12.6V锂电池鳄鱼夹充电器 / 12.6V Lithium Alligator Clip Charger',
        description:
          '专为3串锂电池（12.6V）设计，鳄鱼夹直连。专用CC/CV充电曲线，适用户外电源、太阳能储能包、便携锂电池组。<br /><span class="opacity-70">Purpose-built for 3-cell lithium batteries (12.6V), alligator clip direct connection. Dedicated CC/CV profile for outdoor power stations, solar packs and portable battery banks.</span>',
        icon: 'tabler:bolt',
      },
    ]}
  />

  <Gallery
    id="gallery"
    tagline="产品系列 / Product Series"
    title="从2.4A到36W——focusPower全系列"
    subtitle="同一平台打造的DC鳄鱼夹充电器系列：QC3.0/PD快充、AUTO-ID识别、保护夹设计。"
    columns={3}
    images={galleryImages}
  /> />

  <!-- R&D / Patents *************************************** -->
  <Content
    id="rd"
    isReversed
    tagline="自主研发"
    title="专利技术，不做公模同质化产品"
    items={[
      {
        title: '充电优化电路',
        description:
          '自主充电算法实时平衡电流电压，延长电池寿命、减少过热——已获多项实用新型专利。',
      },
      {
        title: '防水防护外壳',
        description:
          '密封结构设计，室内外两用，IP等级可选，防水、防尘、防潮。',
      },
      {
        title: '鳄鱼夹稳定连接结构',
        description:
          '专利夹口结构，电池端子接触牢固，抗震、防松脱，运输和使用更可靠。',
      },
    ]}
    image={{
      src: '~/assets/images/gallery/factory/fef02e7b6169ca01b940d1c2dc333f46.webp',
      alt: '战神电器自动化生产与老化测试线',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        按需定制，满足你的规格
      </h3>
      我们根据你的目标市场和品牌需求，调整功能、外观、接头类型、插头标准和包装——而不是反过来。
    </Fragment>
  </Content>

  <!-- Factory ********************************************* -->
  <Content
    id="factory"
    isAfterContent
    tagline="工厂实力"
    title="8000㎡厂房，日产10万台稳定供货"
    items={[
      {
        title: '全自动化生产线',
        description:
          '自动化SMT、组装、老化测试线，配备精密检测仪器，专业技师操作。',
      },
      {
        title: '全流程品控体系',
        description:
          '原材料检验 → 生产组装 → 100%老化测试 → 出货前全检。每批次可追溯。',
      },
      {
        title: '交期快、供货稳',
        description:
          '日产10万台产能，轻松承接大批量订单，交付周期可预测。',
      },
      {
        title: '全球电压与认证',
        description:
          '可提供CE、RoHS等出口认证文件。产品适配多国电压和插头标准。',
      },
    ]}
    image={{
      src: '~/assets/images/gallery/factory/4f6c111ce99c50ab05180ee1b6fa12f9.webp',
      alt: '中山战神电器生产流水线',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        专为出口量产打造
      </h3>
      专业外贸团队服务品牌商、贸易商和工程客户，提供单证、标签、柜级物流一站式支持。
    </Fragment>
  </Content>

  <!-- OEM / ODM process *********************************** -->
  <Steps
    id="oem"
    tagline="合作流程"
    title="OEM/ODM定制四步走"
    subtitle="从你的需求清单到装柜出货——透明、可复制的流程。"
    items={[
      {
        title: '1. <span class="font-medium">需求确认与报价</span>',
        description:
          '告诉我们你的目标电池类型、电流、接头、插头标准、外观和订单量。我们2个工作日内确认可行性并报价。',
        icon: 'tabler:clipboard-list',
      },
      {
        title: '2. <span class="font-medium">样品确认</span>',
        description:
          '按你的品牌、标签和包装制作产前样品。你测试确认后再开始量产。',
        icon: 'tabler:test-pipe',
      },
      {
        title: '3. <span class="font-medium">量产与质检</span>',
        description:
          '自动化生产线量产，100%老化测试。每个里程碑发送生产和质检照片/视频。',
        icon: 'tabler:building-factory',
      },
      {
        title: '4. <span class="font-medium">出货与售后</span>',
        description:
          '按你的条款出口装箱，提供完整CE/RoHS文件。售后质保和配件支持。',
        icon: 'tabler:truck',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=1600&q=80',
      alt: '出口仓库与集装箱',
    }}
  />

  <!-- Certifications / trust bar **************************** -->
  <SocialProof
    id="certifications"
    classes={{ container: '!py-12 md:!py-16' }}
    items={[
      { value: 'CE', label: '欧盟安全认证', icon: 'tabler:certificate', color: 'text-emerald-500' },
      { value: 'RoHS', label: '有害物质限制', icon: 'tabler:leaf', color: 'text-green-600' },
      { value: '全检', label: '100%老化测试', icon: 'tabler:shield-check', color: 'text-sky-500' },
      { value: 'OEM/ODM', label: '你的品牌，我们生产', icon: 'tabler:adjustments', color: 'text-indigo-500' },
    ]}
  />

  <!-- FAQs ************************************************* -->
  <FAQs
    id="faqs"
    title="常见问题"
    subtitle="客户下试单前最常问的问题。"
    tagline="FAQ"
    schema
    items={[
      {
        title: '起订量是多少？',
        description:
          '现有型号试单MOQ通常为500-1,000台。完整OEM/ODM项目（定制外壳、logo、包装）MOQ按项目面议，通常1,000-3,000台起。',
      },
      {
        title: '可以为我们的品牌定制产品吗？',
        description:
          '可以。支持OEM（logo、颜色、包装、插头标准）和ODM（按你的需求定制功能、接头、外观）。量产前可先做样品。',
      },
      {
        title: '产品有哪些认证？',
        description:
          '产品按出口标准生产，可提供CE和RoHS文件。特定市场的额外认证可按项目沟通。',
      },
      {
        title: '交期多久？',
        description:
          '现货或返单型号，定金后约15-25天。新OEM/ODM项目需加样品确认时间，量产交期一般25-40天，视数量而定。',
      },
      {
        title: '产品出口到哪些地区？',
        description:
          '我们服务欧洲、美洲、中东、东南亚、大洋洲的品牌商、贸易商和工程客户，产品适配当地电压和插头标准。',
      },
      {
        title: '如何获取报价？',
        description:
          '发邮件或加微信，告诉我们目标型号、数量和目的国。我们1-2个工作日内回复规格和FOB/CIF报价。',
      },
    ]}
  />

  <!-- CTA ************************************************* -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: '获取报价',
        href: '/contact',
        icon: 'tabler:send',
      },
    ]}
  >
    <Fragment slot="title">
      想找一家靠谱的12V充电器工厂？<br class="hidden sm:block" />
    </Fragment>
    <Fragment slot="subtitle">
      把你的规格发给我们——2个工作日内回复报价和样品方案。
    </Fragment>
  </CallToAction>
</Layout>
